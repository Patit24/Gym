rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- CORE AUTHENTICATION & ROLE HELPERS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().role == role) ||
        (request.auth.token.email == 'masteradmin@smartgym.com' && (role == 'Super Admin' || role == 'Owner'))
      );
    }

    function isSuperAdmin() {
      return hasRole('Super Admin') || (isAuthenticated() && request.auth.token.email == 'masteradmin@smartgym.com');
    }

    function isOwner() {
      return isSuperAdmin() || hasRole('Owner');
    }

    function isManager() {
      return isOwner() || hasRole('Branch Manager') || hasRole('Manager');
    }

    function isTrainer() {
      return isManager() || hasRole('Trainer') || hasRole('Dietitian');
    }

    function isStaff() {
      return isManager() || isTrainer() || hasRole('Receptionist') || hasRole('Accountant') || hasRole('Employee');
    }

    // --- USERS COLLECTION (App Accounts) ---
    match /users/{userId} {
      // User can read own profile; Staff/Admin can read directory
      allow read: if isUser(userId) || isStaff();
      // Managers can create any user; Self-service signup strictly locked to 'Member' role with no admin permissions
      allow create: if isManager() || (
        isUser(userId) &&
        request.resource.data.role == 'Member' &&
        (!('isProtected' in request.resource.data) || request.resource.data.isProtected == false) &&
        (!('permissions' in request.resource.data) || (
          request.resource.data.permissions.canManageFinance == false &&
          request.resource.data.permissions.canAccessAdmin == false
        ))
      );
      // Admin can update all; User can only update non-privileged self-service fields
      allow update: if isManager() || (
        isUser(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'id', 'permissions', 'createdByAdminId', 'isProtected', 'branchId', 'linkedId'
        ])
      );
      allow delete: if isOwner();
    }

    // --- MEMBERS COLLECTION ---
    match /members/{memberId} {
      // Staff can read all members; member can only read their own verified record
      allow read: if isStaff() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.id == request.auth.uid ||
          memberId == request.auth.uid
        )
      );
      allow create: if isStaff();
      // Admin/Staff can update everything; Member can only update self-service personal bio/profile info
      allow update: if isStaff() || (
        isAuthenticated() && (
          (resource.data.userId == request.auth.uid || resource.data.id == request.auth.uid || memberId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'paidAmount', 'pendingDues', 'balanceDue', 'totalPlanAmount', 
            'planId', 'planName', 'startDate', 'endDate', 'expiryDate', 
            'membershipNo', 'rewardPoints', 'paymentStatus', 'branchId', 'assignedTrainerId', 'assignedDietitianId'
          ])
        )
      );
      allow delete: if isOwner();
    }

    // --- EMPLOYEES COLLECTION ---
    match /employees/{employeeId} {
      // Staff only (trainers, accountants, managers); hidden from regular members
      allow read: if isStaff();
      allow write: if isManager();
    }

    // --- BRANCHES & PLANS & CONFIG ---
    match /branches/{branchId} {
      allow read: if true; // Public for website and app
      allow write: if isOwner();
    }

    match /plans/{planId} {
      allow read: if true; // Public for website and app
      allow write: if isManager();
    }

    match /expenseTypes/{typeId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // --- WORKOUTS & DIETS ---
    match /workouts/{memberId} {
      allow read: if isStaff() || isUser(memberId) || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow write: if isTrainer();
    }

    match /diets/{memberId} {
      allow read: if isStaff() || isUser(memberId) || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow write: if isTrainer();
    }

    // --- WORKOUT LOGS & PROGRESS & WELLNESS ---
    match /workoutLogs/{logId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow create: if isAuthenticated() && (
        isStaff() || request.resource.data.memberId == request.auth.uid
      );
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
    }

    match /progress/{progressId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow write: if isStaff() || (isAuthenticated() && request.resource.data.memberId == request.auth.uid);
    }

    match /wellnessCheckins/{checkinId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow write: if isAuthenticated() && (
        isStaff() || request.resource.data.memberId == request.auth.uid
      );
    }

    match /trainerNotes/{noteId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow write: if isTrainer();
    }

    // --- ATTENDANCE ---
    match /attendance/{recordId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow create: if isStaff() || (isAuthenticated() && request.resource.data.memberId == request.auth.uid);
      allow update, delete: if isManager();
    }

    // --- TRANSACTIONS & FINANCE ---
    // Trainers strictly prohibited from reading financial transaction logs or reports
    match /transactions/{txnId} {
      allow read: if isManager() || hasRole('Accountant') || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow create: if isStaff() || (isAuthenticated() && request.resource.data.memberId == request.auth.uid);
      allow update, delete: if isManager() || hasRole('Accountant');
    }

    match /expenses/{expenseId} {
      allow read: if isManager() || hasRole('Accountant');
      allow write: if isManager() || hasRole('Accountant');
    }

    // --- LEADS & CRM ---
    match /leads/{leadId} {
      allow read, write: if isStaff();
    }

    // --- LOCKERS, EQUIPMENT, MAINTENANCE, COMPLAINTS ---
    match /lockers/{lockerId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /equipment/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /maintenanceLogs/{logId} {
      allow read, write: if isStaff();
    }

    match /complaints/{complaintId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.memberId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isManager();
    }

    // --- AUDIT LOGS (Immutable security logs) ---
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strict tamper-resistance
    }

    // --- NOTIFICATIONS, CHALLENGES, REFERRALS ---
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isStaff() || resource.data.targetRole == 'all' || resource.data.userId == request.auth.uid
      );
      allow write: if isStaff();
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /referrals/{referralId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.referrerMemberId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.referrerMemberId == request.auth.uid;
      allow update, delete: if isManager();
    }

    match /freezeRecords/{freezeId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      allow write: if isStaff();
    }

    match /supplements/{productId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /stockPurchases/{purchaseId} {
      allow read, write: if isStaff();
    }

    // --- DEFAULT DENY FOR EVERYTHING ELSE ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
